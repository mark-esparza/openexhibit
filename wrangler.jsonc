{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openexhibit",
  "main": "src/worker.ts",
  "compatibility_date": "2025-09-01",
  "observability": { "enabled": true },
  // Static files in ./public. run_worker_first sends every request through the Worker first,
  // so maintenance mode and security headers cover the whole site.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  // Per-visitor limit on API calls: 30 per minute. Each search makes several Wikimedia requests.
  "ratelimits": [
    { "name": "API_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
  ],
  "vars": {
    // Sent in the User-Agent header, as Wikimedia's policy asks.
    "CONTACT": "https://github.com/mark-esparza/openexhibit",
    // "true" takes the site offline with a "temporarily unavailable" page. Set to "false" to bring it back.
    "MAINTENANCE": "false"
  }
}
